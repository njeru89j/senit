<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Parcel ready for collection</title>
</head>
<body style="margin:0;background:#f5f6f8;font-family:Arial,sans-serif;color:#17213b">
  <div style="max-width:600px;margin:0 auto;padding:32px 16px">
    <div style="background:#17213b;padding:22px;border-radius:12px 12px 0 0;text-align:center">
      <strong style="font-size:28px;color:#dbbb02">SendIT</strong>
    </div>
    <div style="background:#fff;padding:32px;border-radius:0 0 12px 12px">
      <h1 style="font-size:22px;margin-top:0">Your parcel is ready</h1>
      <p>Hello <strong><%= name %></strong>,</p>
      <p>Parcel <strong><%= trackingNumber %></strong> is ready for collection at <strong><%= location %></strong>.</p>
      <% if (locker) { %>
        <p>Locker: <strong><%= locker %></strong></p>
      <% } %>
      <% if (collectionCode) { %>
        <div style="margin:24px 0;padding:18px;background:#fff8d6;border:1px solid #dbbb02;border-radius:8px;text-align:center">
          <div style="font-size:13px">Collection code</div>
          <strong style="font-size:30px;letter-spacing:6px"><%= collectionCode %></strong>
        </div>
      <% } else { %>
        <p>You may collect it directly or request a locker from your SendIT account within 12 hours.</p>
      <% } %>
      <p>Please collect it before <strong><%= deadline %></strong>.</p>
      <p style="text-align:center;margin-top:28px"><a href="<%= baseUrl %>/user/parcel-details/<%= parcelId %>" style="background:#dbbb02;color:#17213b;text-decoration:none;padding:12px 20px;border-radius:7px;font-weight:bold">View parcel</a></p>
      <p style="font-size:12px;color:#667085;margin-top:28px">Keep a locker collection code private. SendIT staff will never ask for your password.</p>
    </div>
  </div>
</body>
</html>
