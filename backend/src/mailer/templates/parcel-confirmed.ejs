<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Parcel confirmed</title></head>
<body style="margin:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#202124">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="padding:28px 12px"><tr><td align="center"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:640px;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 10px 28px rgba(0,0,0,.1)">
<tr><td style="padding:26px 32px;background:#171717;color:#fff"><div style="font-size:25px;font-weight:800">Send<span style="color:#dbbb02">IT</span></div><div style="margin-top:7px;font-size:11px;letter-spacing:1.4px;color:#d1d5db;text-transform:uppercase">Parcel confirmation receipt</div></td></tr>
<tr><td style="padding:32px"><span style="display:inline-block;padding:7px 11px;border-radius:999px;background:#eaf8ef;color:#16703a;font-size:11px;font-weight:700">&#10003; CONFIRMED AT TRANSIT POINT</span><h1 style="margin:18px 0 9px;font-size:26px;color:#171717">Your parcel is on its way</h1><p style="margin:0;color:#4b5563;font-size:15px;line-height:1.65">Hello <strong><%= name %></strong>, the parcel has been physically received at <strong><%= confirmedLocation %></strong>.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:24px 0;background:#fff8db;border:1px solid #f1dd7f;border-radius:12px"><tr><td style="padding:20px"><div style="font-size:11px;font-weight:700;letter-spacing:1px;color:#75600a;text-transform:uppercase">Tracking number</div><div style="margin-top:7px;font:700 21px Consolas,'Courier New',monospace;color:#171717"><%= trackingNumber %></div><div style="margin-top:9px;font-size:13px;color:#4b5563">Status: <strong style="color:#16703a"><%= status %></strong></div></td></tr></table>
<h2 style="margin:0 0 12px;font-size:17px">Journey details</h2><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border:1px solid #e5e7eb;border-radius:10px;font-size:14px"><tr><td style="padding:13px 16px;border-bottom:1px solid #e5e7eb;color:#6b7280;width:34%">Pickup</td><td style="padding:13px 16px;border-bottom:1px solid #e5e7eb;font-weight:600"><%= pickupAddress %></td></tr><tr><td style="padding:13px 16px;border-bottom:1px solid #e5e7eb;color:#6b7280">Delivery</td><td style="padding:13px 16px;border-bottom:1px solid #e5e7eb;font-weight:600"><%= deliveryAddress %></td></tr><tr><td style="padding:13px 16px;border-bottom:1px solid #e5e7eb;color:#6b7280">Weight</td><td style="padding:13px 16px;border-bottom:1px solid #e5e7eb"><%= weight %> kg</td></tr><tr><td style="padding:13px 16px;color:#6b7280">Delivery fee</td><td style="padding:13px 16px"><%= deliveryFee %></td></tr></table>
<h2 style="margin:26px 0 12px;font-size:17px">Sender &amp; receiver</h2><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td width="50%" valign="top" style="padding:15px;background:#f9fafb;border-radius:10px"><div style="font-size:11px;font-weight:700;letter-spacing:1px;color:#6b7280">SENDER</div><div style="margin-top:7px;font-weight:700"><%= senderName %></div><div style="margin-top:4px;font-size:12px;color:#4b5563"><%= senderPhone %><br><%= senderEmail %></div></td><td width="14"></td><td width="50%" valign="top" style="padding:15px;background:#f9fafb;border-radius:10px"><div style="font-size:11px;font-weight:700;letter-spacing:1px;color:#6b7280">RECEIVER</div><div style="margin-top:7px;font-weight:700"><%= recipientName %></div><div style="margin-top:4px;font-size:12px;color:#4b5563"><%= recipientPhone %><br><%= recipientEmail %></div></td></tr></table>
<div style="margin-top:24px;padding:17px;background:#f9fafb;border-radius:10px;font-size:13px;line-height:1.65;color:#4b5563"><strong style="color:#374151">Parcel information</strong><br><strong>Description:</strong> <%= description %><br><strong>Declared value:</strong> <%= value %><br><strong>Instructions:</strong> <%= deliveryInstructions %></div><p style="margin:25px 0 0;font-size:13px;line-height:1.6;color:#6b7280">Keep the tracking number handy. If a locker is assigned, its private collection code will be sent to the receiver only.</p></td></tr>
<tr><td style="padding:20px 32px;background:#171717;color:#aeb3bb;font-size:12px;text-align:center">Reliable deliveries, every step of the way &middot; SendIT</td></tr>
</table></td></tr></table></body></html>
