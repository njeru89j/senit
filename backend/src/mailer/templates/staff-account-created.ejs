<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Your SendIT account</title>
</head>
<body style="margin:0;background:#f5f6f8;font-family:Arial,sans-serif;color:#17213b">
  <div style="max-width:600px;margin:0 auto;padding:32px 16px">
    <div style="background:#17213b;padding:22px;border-radius:12px 12px 0 0;text-align:center">
      <strong style="font-size:28px;color:#dbbb02">SendIT</strong>
    </div>
    <div style="background:#fff;padding:32px;border-radius:0 0 12px 12px">
      <h1 style="font-size:22px;margin-top:0">Your <%= roleLabel %> account is ready</h1>
      <p>Hello <strong><%= name %></strong>,</p>
      <p>An administrator created a SendIT <strong><%= roleLabel %></strong> account for you.</p>
      <p>Sign-in email: <strong><%= email %></strong></p>
      <% if (typeof assignment !== 'undefined' && assignment) { %>
        <p><%= assignment %></p>
      <% } %>
      <p>Your administrator will give you your temporary password. You can also set your own password at any time with <em>Forgot password</em> on the sign-in page.</p>
      <p style="text-align:center;margin-top:28px"><a href="<%= baseUrl %>/login" style="background:#dbbb02;color:#17213b;text-decoration:none;padding:12px 20px;border-radius:7px;font-weight:bold">Sign in</a></p>
      <p style="font-size:12px;color:#667085;margin-top:28px">If you did not expect this account, contact your SendIT administrator.</p>
    </div>
  </div>
</body>
</html>
